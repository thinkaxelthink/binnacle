#!/usr/bin/env bash
# Binnacle pre-commit hook. Installed by setup/common/install-hooks.sh
# (git config core.hooksPath .githooks).
#
# Runs on every commit made with the git binary: by hand, by a script, by
# an agent, and by Obsidian Git's automatic commits on a Mac. (The iPhone
# cannot run hooks; the GitHub Action is the only scan of its commits.)
#
# Rejects the commit when:
#   1. any staged file is larger than 10 MB (BINNACLE_MAX_FILE_BYTES), or
#   2. gitleaks finds a secret in the staged changes, or
#   3. gitleaks cannot be found or fails to run (fail closed: no scan, no
#      commit). Run setup/common/install-hooks.sh after installing
#      gitleaks; it records the binary's path so GUI git clients find it.
#
# The scan is `gitleaks git --pre-commit --staged` (gitleaks 8.19 and later;
# `gitleaks protect --staged` is the deprecated older form) with the vault's
# .gitleaks.toml, the same rules .github/workflows/secret-scan.yml uses.
set -eu

max_bytes=${BINNACLE_MAX_FILE_BYTES:-10485760}
root=$(git rev-parse --show-toplevel)

fail() {
  printf 'binnacle pre-commit: %s\n' "$*" >&2
  exit 1
}

# 1. Size cap on every added, copied, modified or renamed staged file.
too_big=0
while IFS= read -r -d '' path; do
  size=$(git cat-file -s ":$path" 2>/dev/null || echo 0)
  if [ "$size" -gt "$max_bytes" ]; then
    printf 'binnacle pre-commit: %s is %s bytes (limit %s bytes)\n' "$path" "$size" "$max_bytes" >&2
    too_big=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
[ "$too_big" -eq 0 ] || fail "unstage files over the 10 MB cap (git restore --staged <file>)"

# 2. Secret scan. GUI apps such as Obsidian run hooks with a minimal PATH,
#    so do not rely on PATH alone. Look in order at: BINNACLE_GITLEAKS (when
#    set, it is the only candidate); the path setup/common/install-hooks.sh
#    recorded in `git config binnacle.gitleaks`; PATH; then the per-user and
#    Homebrew install locations.
find_gitleaks() {
  local c
  if [ -n "${BINNACLE_GITLEAKS:-}" ]; then
    if [ -f "$BINNACLE_GITLEAKS" ] && [ -x "$BINNACLE_GITLEAKS" ]; then
      printf '%s\n' "$BINNACLE_GITLEAKS"
    fi
    return 0
  fi
  for c in "$(git config --get binnacle.gitleaks || true)" \
    "$(command -v gitleaks || true)" \
    "${HOME:+$HOME/.local/bin/gitleaks}" \
    /opt/homebrew/bin/gitleaks /usr/local/bin/gitleaks; do
    if [ -n "$c" ] && [ -f "$c" ] && [ -x "$c" ]; then
      printf '%s\n' "$c"
      return 0
    fi
  done
}
gitleaks=$(find_gitleaks)
[ -n "$gitleaks" ] \
  || fail "gitleaks not found - install it (gitleaks step in setup/<device>/CHECKLIST.md), then run setup/common/install-hooks.sh to record its path; refusing to commit unscanned"

# A finding exits 2 (--exit-code), so it is told apart from gitleaks failing
# to run (exit 1). --verbose names the file, line and rule; --redact keeps
# the secret itself out of the output; --no-color keeps Obsidian's error
# notice readable.
set -- git --pre-commit --staged --redact --no-banner --no-color --verbose \
  --log-level warn --exit-code 2
[ -f "$root/.gitleaks.toml" ] && set -- "$@" --config "$root/.gitleaks.toml"
rc=0
( cd "$root" && "$gitleaks" "$@" "$root" ) >&2 || rc=$?
case $rc in
  0) ;;
  2)
    cat >&2 <<'MSG'
binnacle pre-commit: gitleaks found a secret in the staged changes (File,
Line and RuleID above); nothing was committed.
  - Remove the secret from the file, `git add` it again and commit. Treat
    the secret as exposed: rotate it.
  - A false positive: add its Fingerprint line to .gitleaksignore at the
    vault root, stage that file and commit.
  - To commit anyway, deliberately: git commit --no-verify. That skips this
    local scan only (and the 10 MB cap); the secret-scan Action still scans
    the push on GitHub, but a direct push to main is already on GitHub by
    the time it reports.
MSG
    exit 1
    ;;
  *) fail "gitleaks failed to run (exit $rc, see above); refusing to commit unscanned" ;;
esac
